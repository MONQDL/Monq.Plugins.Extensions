<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.1.0</Version>
    <VersionSuffix>$(VersionSuffix)</VersionSuffix>
    <Version Condition=" '$(VersionSuffix)' != '' ">$(Version)-$(VersionSuffix)</Version>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Authors>Yaroslav Lobov</Authors>
    <Company>MONQ Digital lab</Company>
    <Title>Monq.Plugins.Extensions</Title>
    <PackageId>Monq.Plugins.Extensions</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageTags>monq monq-agent plugins extensions library</PackageTags>
    <PackageProjectUrl>https://github.com/MONQDL/Monq.Plugins.Extensions</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MONQDL/Monq.Plugins.Extensions</RepositoryUrl>
    <Description>Reusable extensions, parsers and utilities for MONQ Agent plugins.</Description>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>Monq.Plugins.Extensions.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
